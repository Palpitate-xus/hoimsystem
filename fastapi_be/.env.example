# 运行环境：development / production
ENVIRONMENT=development

# 开发默认可使用 SQLite；生产必须改为 PostgreSQL 并关闭自动建表
DATABASE_URL=sqlite:///./test.db
# DATABASE_URL=postgresql://hoimsystem:replace-me@localhost:5432/hoimsystem
# 根目录 Compose 使用此值创建 PostgreSQL，并自行构造容器内 DATABASE_URL
POSTGRES_PASSWORD=
AUTO_CREATE_SCHEMA=true

# 也可不用 DATABASE_URL，改用以下 PostgreSQL 分项配置
# DB_USER=hoimsystem
# DB_PASSWORD=replace-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hoimsystem

# PostgreSQL 连接池与语句超时
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000

# JWT 与浏览器来源。生产 SECRET_KEY 必须使用独立强随机值；禁止通配符来源
SECRET_KEY=development-only-change-me
ALLOWED_ORIGINS=http://localhost:8091,http://127.0.0.1:8091
# 多副本生产环境由密钥管理服务注入同一份 PEM；不要把真实私钥提交到 .env 或版本库
TRANSPORT_RSA_PRIVATE_KEY_PEM=

# 多实例实时事件、就绪探针和跨进程回放；留空时仅使用单进程内存事件总线
REDIS_URL=

# 独立调度进程。生产 Compose 已在 backend 中关闭、在 scheduler 中开启
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600

# LIS / PACS / 医保 / 支付集成：入站鉴权密钥与出站 HTTPS 地址
LIS_INTEGRATION_KEY=
PACS_INTEGRATION_KEY=
MEDICAL_INSURANCE_INTEGRATION_KEY=
PAYMENT_INTEGRATION_KEY=
LIS_OUTBOUND_URL=
PACS_OUTBOUND_URL=
MEDICAL_INSURANCE_OUTBOUND_URL=
PAYMENT_OUTBOUND_URL=
INTEGRATION_HTTP_TIMEOUT_SECONDS=10
INTEGRATION_MAX_ATTEMPTS=8
INTEGRATION_OUTBOX_INTERVAL_SECONDS=10

# Gunicorn 多进程 Prometheus 模式使用；启动钩子会清理目录中的遗留指标文件
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# AI：先配置部署边界，再由超级管理员在“AI 管理中心”管理模型、功能、Prompt 和知识。
# 允许的模型主机使用逗号分隔；非本机端点使用 HTTPS。不包含路径或端口。
AI_PROVIDER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# 加密保存模型密钥时使用的独立稳定主密钥（至少32字符）。留空时可使用模型密钥环境变量引用。
AI_CREDENTIAL_KEY=
AI_MODEL_API_KEY=
AI_MAX_INPUT_CHARS=20000
AI_MAX_CONTEXT_CHARS=40000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_QUEUE_AGE_SECONDS=900
# API与worker须挂载同一私有目录；禁止放入app/uploads。默认单文件64MiB、解码1小时、每用户512MiB。
AI_AUDIO_STORAGE_DIR=private/ai-audio
AI_AUDIO_MAX_BYTES=67108864
AI_AUDIO_MAX_DURATION_SECONDS=3600
AI_AUDIO_USER_QUOTA_BYTES=536870912
AI_AUDIO_PROCESS_TIMEOUT_SECONDS=30
# 原始心电使用独立私有目录，API与AI工作进程必须共享同一存储。
AI_ECG_STORAGE_DIR=private/ai-ecg
AI_ECG_MAX_BYTES=33554432
AI_ECG_MAX_DURATION_SECONDS=300
AI_ECG_USER_QUOTA_BYTES=536870912
# Private native single-frame DICOM + tag-free int32 stored samples; separate from public uploads
AI_IMAGE_STORAGE_DIR=private/ai-images
AI_IMAGE_MAX_BYTES=67108864
AI_IMAGE_MAX_PIXELS=16777216
AI_IMAGE_USER_QUOTA_BYTES=1073741824
# 文本任务在独立进程执行：python -m app.ai.worker

# 可选独立胸片服务：这些值须显式放入服务进程环境；独立服务不读取本项目.env。
# 将同一个独立随机密钥提供给适配服务与医院API/AI worker的进程环境，勿写入Git。
AI_PROVIDER_LOCAL_IMAGING_API_KEY=
IMAGING_MODEL_DIR=/srv/models/hoim-imaging-v1
IMAGING_CPU_THREADS=4
IMAGING_MAX_BYTES=67108864
IMAGING_TIMEOUT_SECONDS=60
