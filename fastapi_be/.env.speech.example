# Export these variables into the optional speech process; it does not read .env automatically.
# Also expose this one credential to API/worker if the provider references it by name.
AI_PROVIDER_LOCAL_SPEECH_API_KEY=

# An absolute directory prepared with scripts/prepare_speech_model.py, mounted read-only.
SPEECH_MODEL_DIR=/srv/hoim/models/speech-reviewed-version
# zh or another actual model-supported language, or auto. The synthetic smoke uses en.
SPEECH_LANGUAGE=zh
SPEECH_CPU_THREADS=4
SPEECH_BEAM_SIZE=5
SPEECH_MAX_BYTES=67108864
SPEECH_MAX_DURATION_SECONDS=300
# The registered model request timeout should exceed this, e.g. 120 seconds.
SPEECH_TIMEOUT_SECONDS=110
