FROM python:3.12-slim AS dependencies

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-aki.txt ./
RUN pip install --no-cache-dir -r requirements-aki.txt \
    && groupadd --gid 10001 aki \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin aki

FROM dependencies AS runtime

COPY app/__init__.py ./app/__init__.py
COPY app/ai/__init__.py ./app/ai/__init__.py
COPY app/ai/aki_contract.py \
    app/ai/aki_model.py \
    app/ai/aki_config.py \
    app/ai/aki_server.py ./app/ai/

USER 10001:10001
EXPOSE 8815
CMD ["python", "-m", "app.ai.aki_server", "--host", "0.0.0.0"]
