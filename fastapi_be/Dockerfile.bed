FROM public.ecr.aws/docker/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS dependencies

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-build.lock requirements-bed.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-build.lock \
    && python -m pip install --no-cache-dir --require-hashes -r requirements-bed.lock \
    && python -m pip check \
    && groupadd --gid 10001 bed \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin bed

FROM dependencies AS runtime

COPY app/__init__.py ./app/__init__.py
COPY app/ai/__init__.py ./app/ai/__init__.py
COPY app/ai/bed_contract.py \
    app/ai/bed_model.py \
    app/ai/bed_config.py \
    app/ai/bed_server.py ./app/ai/

USER 10001:10001
EXPOSE 8820
CMD ["python", "-m", "app.ai.bed_server", "--host", "0.0.0.0"]
