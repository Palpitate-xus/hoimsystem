FROM public.ecr.aws/docker/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    ECG_MODEL_DIR=/models

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-build.lock requirements.lock requirements-ecg.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-build.lock \
    && python -m pip install --no-cache-dir --require-hashes --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.lock -r requirements-ecg.lock \
    && python -m pip check \
    && useradd --system --uid 10001 --create-home ecg

COPY app ./app
COPY third_party/ssl-ecg ./third_party/ssl-ecg
COPY third_party/torchxrayvision ./third_party/torchxrayvision
COPY scripts/smoke_local_ecg.py ./scripts/smoke_local_ecg.py
USER 10001:10001
EXPOSE 8811
CMD ["python", "-m", "app.ai.ecg_server", "--host", "0.0.0.0"]
