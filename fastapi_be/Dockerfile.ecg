FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    ECG_MODEL_DIR=/models

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-ecg.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ecg.txt \
    && useradd --system --uid 10001 --create-home ecg

COPY app ./app
COPY third_party/ssl-ecg ./third_party/ssl-ecg
COPY scripts/smoke_local_ecg.py ./scripts/smoke_local_ecg.py
USER 10001:10001
EXPOSE 8811
CMD ["python", "-m", "app.ai.ecg_server", "--host", "0.0.0.0"]
