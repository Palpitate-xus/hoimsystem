FROM public.ecr.aws/docker/library/python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS dependencies

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-build.lock requirements-forecast.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-build.lock \
    && python -m pip install --no-cache-dir --require-hashes -r requirements-forecast.lock \
    && python -m pip check \
    && groupadd --gid 10001 forecast \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin forecast

FROM dependencies AS runtime

COPY app/__init__.py ./app/__init__.py
COPY app/ai/__init__.py ./app/ai/__init__.py
COPY app/ai/forecast_contract.py \
    app/ai/forecast_model.py \
    app/ai/forecast_config.py \
    app/ai/forecast_server.py ./app/ai/
COPY scripts/smoke_local_forecast.py ./scripts/smoke_local_forecast.py

USER 10001:10001
EXPOSE 8813
CMD ["python", "-m", "app.ai.forecast_server", "--host", "0.0.0.0"]
