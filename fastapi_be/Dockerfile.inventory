FROM python:3.12-slim AS dependencies

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-inventory.txt ./
RUN pip install --no-cache-dir -r requirements-inventory.txt \
    && groupadd --gid 10001 inventory \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin inventory

FROM dependencies AS runtime

COPY app/__init__.py ./app/__init__.py
COPY app/ai/__init__.py ./app/ai/__init__.py
COPY app/ai/inventory_contract.py \
    app/ai/inventory_model.py \
    app/ai/inventory_config.py \
    app/ai/inventory_server.py ./app/ai/

USER 10001:10001
EXPOSE 8823
CMD ["python", "-m", "app.ai.inventory_server", "--host", "0.0.0.0"]
