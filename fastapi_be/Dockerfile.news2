FROM python:3.12-slim AS dependencies

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-news2.txt ./
RUN pip install --no-cache-dir -r requirements-news2.txt \
    && groupadd --gid 10001 news2 \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin news2

FROM dependencies AS runtime

COPY app/__init__.py ./app/__init__.py
COPY app/ai/__init__.py ./app/ai/__init__.py
COPY app/ai/news2_contract.py \
    app/ai/news2_model.py \
    app/ai/news2_config.py \
    app/ai/news2_server.py ./app/ai/

USER 10001:10001
EXPOSE 8814
CMD ["python", "-m", "app.ai.news2_server", "--host", "0.0.0.0"]
