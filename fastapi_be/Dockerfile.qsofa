FROM python:3.12-slim AS dependencies

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-qsofa.txt ./
RUN pip install --no-cache-dir -r requirements-qsofa.txt \
    && groupadd --gid 10001 qsofa \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin qsofa

FROM dependencies AS runtime

COPY app/__init__.py ./app/__init__.py
COPY app/ai/__init__.py ./app/ai/__init__.py
COPY app/ai/qsofa_contract.py \
    app/ai/qsofa_model.py \
    app/ai/qsofa_config.py \
    app/ai/qsofa_server.py ./app/ai/

USER 10001:10001
EXPOSE 8816
CMD ["python", "-m", "app.ai.qsofa_server", "--host", "0.0.0.0"]
