FROM public.ecr.aws/docker/library/python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS dependencies

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-build.lock requirements-sofa.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-build.lock \
    && python -m pip install --no-cache-dir --require-hashes -r requirements-sofa.lock \
    && python -m pip check \
    && groupadd --gid 10001 sofa \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin sofa

FROM dependencies AS runtime

COPY app/__init__.py ./app/__init__.py
COPY app/ai/__init__.py ./app/ai/__init__.py
COPY app/ai/sofa_contract.py \
    app/ai/sofa_model.py \
    app/ai/sofa_config.py \
    app/ai/sofa_server.py ./app/ai/

USER 10001:10001
EXPOSE 8818
CMD ["python", "-m", "app.ai.sofa_server", "--host", "0.0.0.0"]
